# Local development. Copy to .env and fill in — .env is gitignored.

# Which backend serves the model. One of: groq, ollama, openai.
# Read once at import time, so changing it needs a restart.
LLM_PROVIDER=groq

# The model, configured per backend: a model id only means something to the
# server that serves it, so a Groq id aimed at Ollama is a config error, not a
# fallback. Leave one unset to get that provider's built-in default
# (groq: openai/gpt-oss-120b, ollama: llama3.1, openai: gpt-4o-mini).
# These are read on every call, so a change takes effect without a restart.
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_MODEL=qwen3:8b
# OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=gsk_your_key_here
